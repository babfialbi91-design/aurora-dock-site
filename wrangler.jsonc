{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "aurora-dock",
  "main": "src/index.js",
  "compatibility_date": "2026-07-21",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/latest", "/download/*"]
  },
  "observability": {
    "enabled": true
  },
  "vars": {
    "GH_REPO": "babfialbi91-design/seelen-aurora-dock"
  }
}
